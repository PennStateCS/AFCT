generator client {
  provider = "prisma-client-js"
}

// Entity-relationship diagram, emitted as Mermaid inside Markdown and published on
// the docs site, which renders Mermaid natively.
//
// Deliberately NOT prisma-erd-generator: that renders to SVG through mermaid-cli,
// which drags in puppeteer and a ~150MB Chromium purely to rasterise a picture.
// This one has a single dependency and writes text.
//
// The output is COMMITTED and CI checks it for drift, the same arrangement as
// src/types/api.ts. Regenerate with `npm run docs`. This generator is not part of the
// app's runtime: postinstall, both images and the container entrypoint all run
// `prisma generate --generator client`, so nothing outside a developer machine or CI
// does documentation work.
//
// Models are appended at the END of this file, so anything that must stay next to its
// explanation belongs up here with the other generators. This block and its comment had
// already drifted a couple of hundred lines apart.
generator erd {
  provider = "prisma-markdown"
  output   = "../docs-site/docs/reference/database-schema.md"
  title    = "Database schema"
}

datasource db {
  provider = "postgresql"
}

enum CourseRole {
  FACULTY
  TA
  STUDENT
}

// A student's standing in a course, distinct from their CourseRole. ENROLLED students
// can see and interact with the course; DROPPED students keep their association and all
// their work (submissions, grades, group membership, audience/override rows) but lose
// access, and staff-facing views mark them "Dropped". Applies only to STUDENT rows;
// FACULTY/TA are always ENROLLED. See lib/roster-status for the shared predicates.
enum EnrollmentStatus {
  ENROLLED
  DROPPED
}

enum ProblemType {
  PDA
  RE
  CFG
  FA
  TM
}

enum SubmissionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// How the empty string is rendered in automata/languages for a course.
enum EmptyStringNotation {
  EPSILON // ε
  LAMBDA // λ
}

// Severity/level of an audit-log entry.
enum LogSeverity {
  INFO // routine, successful activity
  WARNING // expected rejections / invalid input / non-fatal issues
  ERROR // system or operational failures
  SECURITY // auth failures and access-control denials
}

// Who a per-target row (AssignmentOverride, SubmissionGrant) targets.
enum OverrideTargetType {
  STUDENT // userId set, groupId null
  GROUP // groupId set, userId null
}

// How an assignment/problem description is stored. PLAIN_TEXT keeps the legacy `description`
// string as the source of truth; TIPTAP_JSON means the rich source lives in `descriptionJson`
// and `description` holds derived plain text for legacy clients.
// How AFCT connects to a mail server. STARTTLS is what most institutional servers expect on
// port 587; TLS is an implicit-TLS connection, usually port 465. NONE exists for a relay on a
// trusted internal network and should be rare.
enum SmtpSecurity {
  NONE
  STARTTLS
  TLS
}

enum DescriptionFormat {
  PLAIN_TEXT
  TIPTAP_JSON
}

// Who produced a problem grade. Distinct from whether that grade is held against automatic
// grading (`AssignmentProblemGrade.gradedManually`): staff can release a grade they entered
// themselves, or hold one the autograder wrote, so neither flag can be inferred from the other.
enum GradeSource {
  AUTOGRADER
  MANUAL
}

// What a single-use token authorises. One table rather than one per purpose, because they all
// need the same properties (hashed at rest, expiring, used exactly once) and getting any of
// those wrong once is better than getting them wrong three times.
enum SingleUseTokenPurpose {
  PASSWORD_RESET
  /// Handed to the browser once a launch is verified, and spent immediately to create the
  /// session. Exists because sessions are minted by NextAuth, not by the launch endpoint.
  LTI_SESSION_TICKET
  /// Minted by an administrator, pasted into an LMS's automatic-registration field, and spent
  /// when that LMS calls back to register itself. It is what stands in for a session on that
  /// callback: the LMS frames AFCT from another site, so no cookie of ours arrives with it.
  LTI_DYNAMIC_REGISTRATION
}

// What kind of system vouched for an identity. Descriptive rather than structural: a single
// issuer can be both (Canvas is an LTI platform and can be an OIDC provider), and when it is,
// the same person is the same person.
enum IdentityProviderKind {
  OIDC
  LTI
}

// How a link came to exist. Kept on the row because it is a property of the link itself, and
// because "was this attached automatically or did a person do it deliberately" is the first
// question anyone asks when a link turns out to be wrong. Who did it lives in the activity log,
// which is the audit trail for everything else too.
enum IdentityLinkMethod {
  /// Matched to an existing account by an email the provider asserted as verified.
  AUTO_VERIFIED_EMAIL
  /// The account was created for this identity at first sign-in.
  JUST_IN_TIME
  /// The signed-in user attached it themselves.
  SELF_SERVICE
  /// An administrator attached it to an account.
  ADMIN
}

/// A person with an account: student, teaching assistant, faculty member or system
/// administrator. One account is used across every course; what a person may do in a given
/// course comes from their Roster row, not from this record.
///
/// @namespace Identity
/// @erd Assignments
/// @erd Courses
/// @erd Submissions
/// @erd System
/// @erd LTI
model User {
  /// Unique identifier.
  id                String  @id @default(cuid())
  /// Sign-in address, and the identifier the institution's systems recognise.
  email             String  @unique
  /// Given name.
  firstName         String?
  /// Family name.
  lastName          String?
  /// bcrypt hash of the local password, or null for an account that has none. The plain
  /// password is never stored.
  ///
  /// Optional because an account will be able to exist without one: an identity provider or an
  /// LMS launch can vouch for someone who never chose an AFCT password. Nothing creates such an
  /// account yet, but every reader must already treat null as "cannot sign in with a password"
  /// rather than assume a string is there.
  password          String?
  /// Whether the current password was issued by an administrator and must be changed at next sign-in.
  temporaryPassword Boolean @default(false)
  /// Whether this account administers the installation. What a person may do inside a particular
  /// course comes from their Roster row instead; this is the only privilege that is global.
  isAdmin           Boolean @default(false)
  /// Uploaded profile image, if any.
  avatar            String?
  /// How the avatar is framed. The uploaded image is stored unchanged and the framing is applied
  /// when it is displayed, so re-cropping never needs a re-upload.
  cropX             Float?
  /// Vertical framing of the avatar.
  cropY             Float?
  /// Zoom level applied to the avatar.
  zoom              Float?
  /// Preferred timezone for displaying times. Falls back to the installation default.
  timezone          String?
  /// Whether the account has been disabled. An inactive account cannot sign in but its records remain.
  inactive          Boolean @default(false)

  /// When the password was last changed. Sessions issued before this moment stop being accepted,
  /// so a password reset ends any session an intruder already had rather than leaving it valid
  /// until it expires.
  passwordChangedAt DateTime?

  /// Last successful sign-in. Stored on the account rather than derived from the activity log, so
  /// it survives log pruning.
  lastLogin DateTime?

  /// When a temporary lockout ends, after too many failed sign-in attempts. The lock clears
  /// itself once the time passes, and an administrator can lift it early. Empty means the account
  /// is not locked.
  lockedUntil DateTime?

  /// When this record was created.
  createdAt DateTime @default(now())
  /// When this record was last changed.
  updatedAt DateTime @updatedAt

  rosterEntries       Roster[]
  submissions         Submission[]
  problemGrades       AssignmentProblemGrade[]
  activityLogs        ActivityLog[]
  commentsAbout       Comment[]                @relation("CommentsAboutStudent") // Comments about this student's work
  commentsAuthored    Comment[]                @relation("CommentAuthor") // Comments this user wrote
  clientTokens        ClientApiToken[] // Bearer tokens issued to the native (Java) client
  singleUseTokens     SingleUseToken[] // Password-reset and similar one-shot links
  linkedIdentities    LinkedIdentity[] // Institutional sign-ins and LMS launches mapped to this account
  assignmentAssignees AssignmentAssignee[]     @relation("AssigneeTarget") // assignments this student is individually assigned
  assignmentOverrides AssignmentOverride[]     @relation("OverrideTarget") // deadline overrides targeting this student
  overridesCreated    AssignmentOverride[]     @relation("OverrideCreatedBy") // overrides this user created
  submissionGrants    SubmissionGrant[]        @relation("SubmissionGrantTarget") // extra-submission grants targeting this student
  grantsCreated       SubmissionGrant[]        @relation("SubmissionGrantCreatedBy") // grants this user created
  ltiLinksCreated     LtiContextLink[] // LMS course links this user decided
  ltiDeepLinksCreated LtiDeepLink[] // assignment links this user added to an LMS course
  ltiPendingLinks     LtiPendingLink[] // launches waiting for this user to pick a course
  ltiPendingDeepLinks LtiPendingDeepLink[] // deep-linking requests waiting on this user
  ltiContextMembers   LtiContextMember[] // the LMS courses this person has been seen in
  ltiScores           LtiScoreQueue[] // their grades queued for an LMS gradebook
  evaluatorTrials     EvaluatorTrial[] // staff dry runs of the evaluator this user asked for

  @@index([isAdmin])
  @@index([inactive])
  @@index([createdAt])
  // Rosters and the admin user list are both read surname-first. Ordering a course roster
  // is a join order (the names live here, not on Roster), so this cannot make that plan
  // index-only; it does keep the sort side off a full scan as courses reach the thousands.
  @@index([lastName, firstName])
  /// Launches that matched this account and are waiting for a password to confirm it.
  ltiPendingIdentityLinks LtiPendingIdentityLink[]
}

/// Bearer token for the native submission client. The browser signs in with a session cookie;
/// the desktop client authenticates with one of these instead. Only a hash of the token is
/// stored, and the plaintext is shown once when it is issued. Tokens can be revoked and can
/// expire, so a lost machine or an outdated client can be cut off without changing the owner's
/// password.
///
/// @namespace Identity
model ClientApiToken {
  /// Unique identifier.
  id        String @id @default(cuid())
  /// Hash of the token. The token itself is shown once when issued and never stored.
  tokenHash String @unique // sha256(token), never the plaintext

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The account the token acts as.
  userId String

  /// Optional name for the token, so its owner can tell devices apart.
  label String?

  /// When this record was created.
  createdAt  DateTime  @default(now())
  /// When the token was last used, so unused tokens can be spotted.
  lastUsedAt DateTime?
  /// When the token stops working. Empty means it does not expire on its own.
  expiresAt  DateTime?
  /// When the token was withdrawn. Once set, the token is refused.
  revokedAt  DateTime?

  @@index([userId])
}

/// An institutional identity mapped to an AFCT account: an OIDC sign-in, or a person arriving
/// through an LMS launch.
///
/// Accounts stay the unit of identity in AFCT. This does not become a parallel user table; it
/// records that some outside system vouches for a person who already has an account here.
///
/// **Keyed on issuer plus subject, never email.** The subject is the provider's stable
/// identifier for a person, so a link survives a name change, a marriage, or a department
/// moving someone's address. Email is used once, to *find* the account to attach to, and is
/// not what holds the link together afterwards.
///
/// @namespace Identity
model LinkedIdentity {
  /// Unique identifier.
  id      String               @id @default(cuid())
  kind    IdentityProviderKind
  /// The provider's own name for itself: an OIDC issuer URL, or an LTI platform issuer.
  issuer  String
  /// The provider's stable identifier for this person (the `sub` claim). Never an email.
  subject String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The AFCT account this identity signs in as.
  userId String

  /// How the link came to exist.
  linkedVia IdentityLinkMethod
  /// When this record was created.
  createdAt DateTime           @default(now())
  /// Last time somebody signed in through it, so a stale link can be spotted.
  lastSignInAt DateTime?

  /// One account per identity. This is the constraint that stops two people sharing a sign-in
  /// and stops one identity quietly moving between accounts.
  @@unique([issuer, subject])
  @@index([userId])
}

/// An LMS that may launch into AFCT.
///
/// Registration is mutual and manual: an administrator creates a developer key in the LMS, and
/// pastes what it gives back into AFCT. There is no client secret, because LTI 1.3 does not use
/// one; AFCT proves who it is by signing with its own key.
///
/// Keyed on the **triple** of issuer, client id and deployment id rather than on the issuer
/// alone. One LMS can deploy the same tool more than once (a sub-account, a second course set),
/// and each deployment is a distinct registration even though the issuer and client id repeat.
/// Treating the issuer as the key is the classic way to make two deployments collide.
///
/// @namespace LTI
model LtiPlatform {
  /// Unique identifier.
  id           String @id @default(cuid())
  /// What an administrator calls this LMS, for screens. Never used for matching.
  name         String
  /// The platform's own issuer identifier, which appears as `iss` in every launch.
  issuer       String
  /// What the LMS calls AFCT. Appears as `aud` in a launch.
  clientId     String
  /// Which deployment of AFCT within that LMS this is.
  deploymentId String

  /// Where AFCT sends the person to start a launch (the platform's OIDC authorization endpoint).
  authLoginUrl String
  /// Where AFCT asks for access tokens, for grade passback and roster sync.
  tokenUrl     String

  /// The audience to name in the client-assertion JWT, when the platform wants one of its own.
  ///
  /// Almost every platform expects the token endpoint itself, which is what AFCT uses when this is
  /// empty: Canvas, Moodle and Blackboard all do, the last confirmed from Blackboard's own sample
  /// tool. D2L Brightspace is the exception. Its registration hands out a `BrightspaceAudience`
  /// separately from the access token URL, and an assertion addressed to the endpoint instead is
  /// refused, so nothing AFCT sends to a Brightspace course would ever arrive.
  tokenAudience String?
  /// Where AFCT fetches the platform's public keys, to verify that a launch really came from it.
  keysetUrl    String

  /// When this record was created.
  createdAt DateTime @default(now())
  /// When it was last changed.
  updatedAt DateTime @updatedAt

  /// The LMS courses that open into AFCT through this registration.
  contextLinks LtiContextLink[]
  /// Launches waiting for somebody to say which AFCT course they open.
  pendingLinks LtiPendingLink[]
  /// Deep-linking requests waiting for somebody to choose an assignment.
  pendingDeepLinks LtiPendingDeepLink[]

  /// Launches started against this registration.
  launches LtiLaunchTransaction[]

  /// The triple that identifies a registration. Also what a launch is matched against.
  @@unique([issuer, clientId, deploymentId])
}

/// AFCT's own signing keypair, used to sign the token requests it makes to an LMS.
///
/// This is the one secret whose loss is not just a re-typing job. An LMS is registered against
/// the public half, which it fetches from AFCT's JWKS endpoint and caches, so losing the private
/// half means generating a new keypair and re-registering AFCT with every platform.
///
/// Several rows can be published at once, which is what makes rotation possible without an
/// outage: a new key is published and given time to be picked up before anything is signed with
/// it, and the old one stays published until nothing signed by it is still in flight.
///
/// Which key signs is **derived, not stored**: it is the newest published row whose
/// `signingFrom` has passed. There is deliberately no "is the signing key" flag, because a flag
/// would be an invariant needing a database guard and two concurrent rotations could break it.
/// Nothing here can disagree with itself.
///
/// The private half is encrypted at rest like every other secret. The public half is not,
/// because publishing it is the entire point.
///
/// @namespace LTI
model LtiKeyPair {
  /// Unique identifier.
  id         String  @id @default(cuid())
  /// The `kid` in the published JWKS and in the header of every token AFCT signs. This is how
  /// a platform decides which published key to verify a token against, so it never changes.
  kid        String  @unique
  /// PEM, published to anyone who asks.
  publicKey  String
  /// PEM, encrypted at rest. Never leaves the server.
  privateKey String
  /// When this key becomes eligible to sign. Set ahead of time to give platforms a chance to
  /// fetch it first; a platform that has not refreshed its cache cannot verify a token signed
  /// by a key it has never seen.
  signingFrom DateTime @default(now())

  /// When this record was created.
  createdAt DateTime  @default(now())
  /// When it stopped being published. Set rather than deleted, so a token still in flight can
  /// be traced to the key that signed it.
  retiredAt DateTime?

  /// Published keys, which is what the JWKS endpoint reads, and what choosing a signing key
  /// orders over.
  @@index([retiredAt, signingFrom])
}

/// A token that works exactly once, within a time window: the password-reset link today, and
/// the shape anything similar should reuse.
///
/// Only the SHA-256 hash is stored, so a leaked database, or a leaked backup, does not hand
/// anyone a working link. "Used exactly once" is enforced by a conditional update on `usedAt`
/// rather than by reading and then writing, so two simultaneous clicks on the same link cannot
/// both succeed.
///
/// @namespace Identity
model SingleUseToken {
  /// Unique identifier.
  id        String                @id @default(cuid())
  /// sha256(token), never the plaintext.
  tokenHash String                @unique
  /// What the token authorises. A token issued for one purpose is refused for another.
  purpose   SingleUseTokenPurpose

  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Who the token is for. Optional because not every future purpose has a user behind it
  /// (an LTI launch nonce, for instance, is issued before anyone is identified).
  userId String?

  /// When the token stops working.
  expiresAt DateTime
  /// When it was spent. Once set, the token is refused.
  usedAt    DateTime?
  /// When this record was created.
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
  /// Expired rows are swept periodically; this is the index that sweep reads.
  @@index([expiresAt])
}

/// A single offering of a course: one section, in one term, with its own roster, assignments
/// and grades. Deadlines are anchored to the course timezone so a due date means the same
/// instant for everyone enrolled.
///
/// @namespace Courses
/// @erd Assignments
/// @erd Identity
/// @erd Submissions
/// @erd System
/// @erd LTI
model Course {
  /// Unique identifier.
  id                  String    @id @default(cuid())
  /// Course title as students see it.
  name                String
  /// Course code, for example "CMPSC 464".
  code                String
  /// Self-registration code students enter to join, if self-registration is offered.
  regCode             String?   @unique
  /// Term the course runs in, for example "Fall 2026".
  semester            String
  /// Credit hours.
  credits             Int
  /// First day of the course.
  startDate           DateTime
  /// Last day of the course.
  endDate             DateTime
  /// When self-registration opens. Empty means it is open as soon as the course is published.
  registrationOpenAt  DateTime?
  /// When self-registration closes. Empty means it stays open.
  registrationCloseAt DateTime?
  /// Whether students can see the course. Unpublished courses are visible to staff only.
  isPublished         Boolean   @default(false)
  /// Whether the course has been retired. Archived courses are read-only.
  isArchived          Boolean   @default(false)

  /// When the course was deleted. A deleted course is kept so it can be recovered, but is hidden
  /// from everyone except administrators. A course must be archived before it can be deleted.
  deletedAt DateTime?

  /// The timezone that anchors this course's deadlines. Times entered by staff are interpreted
  /// here, so a due date falls at the same moment for every student regardless of where they are.
  timezone String @default("UTC")

  /// Which symbol this course uses for the empty string when displaying automata and languages.
  emptyStringNotation EmptyStringNotation @default(EPSILON)

  /// When this record was created.
  createdAt DateTime @default(now())
  /// When this record was last changed.
  updatedAt DateTime @updatedAt

  roster       Roster[] // Users in the course with roles
  assignments  Assignment[]
  problems     Problem[]
  submissions  Submission[]
  groupSets    GroupSet[]
  activityLogs ActivityLog[]
  ltiLinks     LtiContextLink[] // LMS courses that open into this one

  @@index([isPublished])
  @@index([createdAt])
  @@index([registrationOpenAt])
  @@index([registrationCloseAt])
  @@index([deletedAt])
}

/// One person's place in one course. This is where a role lives: the same account can be a
/// student in one course and a teaching assistant in another. It also carries the student's
/// standing, so a student who drops keeps their record and can be restored.
///
/// @namespace Courses
/// @erd Submissions
model Roster {
  /// Unique identifier.
  id   String     @id @default(cuid())
  /// What this person does in the course: student, teaching assistant or faculty.
  role CourseRole

  /// A student's standing in the course. Applies to students only; staff remain enrolled. A
  /// student who drops loses access but keeps this record and all their work, so re-enrolling
  /// restores everything.
  status    EnrollmentStatus @default(ENROLLED)
  /// When the student dropped, if they did.
  droppedAt DateTime?

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// The course.
  courseId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The person.
  userId String

  /// When this record was created.
  createdAt DateTime @default(now())
  /// When this record was last changed.
  updatedAt DateTime @updatedAt

  comments         Comment[]
  groupMemberships GroupMembership[]

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@index([role])
  // Enumerations of active students filter on (course, role, status), so index the trio.
  @@index([courseId, role, status])
}

/// A piece of work given to a course, made up of one or more problems. It carries the dates
/// that apply to the class as a whole; exceptions for individual students or groups are
/// recorded separately as overrides. An assignment is a group assignment exactly when it names
/// a group set.
///
/// @namespace Assignments
/// @erd Identity
/// @erd Submissions
/// @erd System
/// @erd LTI
model Assignment {
  /// Unique identifier.
  id                 String            @id @default(cuid())
  /// Assignment name as students see it.
  title              String
  // Legacy plain-text description. Stays the source of truth for PLAIN_TEXT rows and holds
  // derived plain text for TIPTAP_JSON rows, so legacy clients keep getting plain text.
  /// Instructions shown to students, as plain text.
  description        String?
  /// Whether the instructions are plain text or formatted.
  descriptionFormat  DescriptionFormat @default(PLAIN_TEXT)
  /// Formatted instructions, when the assignment uses rich text.
  descriptionJson    Json?
  /// When the work is due, in the course timezone.
  dueDate            DateTime
  /// When the assignment becomes available to the class. Empty means it is available immediately.
  /// Individual students or groups can be given a different date through an override.
  unlockAt           DateTime?
  /// Whether the assignment goes to the whole class. When false, it goes only to the students or
  /// groups named as assignees.
  assignedToEveryone Boolean           @default(true)
  /// Whether students can see the assignment.
  isPublished        Boolean           @default(false)

  // Individual vs group is the single fact groupSetId carries: null = individual
  // assignment; set = group assignment tied to that one group set (students are assigned
  // via their group in the set and submit as a group). No mixing sets on one assignment.
  // The Individual/Group label shown on the course page is derived from this, not stored.
  groupSet   GroupSet? @relation(fields: [groupSetId], references: [id], onDelete: SetNull)
  /// The group set used, when this is a group assignment. Empty means students work individually.
  groupSetId String?

  /// Whether work is accepted after the due date. Off unless it is turned on.
  allowLateSubmissions Boolean   @default(false)
  /// Latest moment late work is still accepted. Empty means there is no cutoff.
  lateCutoff           DateTime?

  /// When this record was created.
  createdAt DateTime @default(now())
  /// When this record was last changed.
  updatedAt DateTime @updatedAt

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// The course this assignment belongs to.
  courseId String

  problems     AssignmentProblem[]
  comments     Comment[]
  activityLogs ActivityLog[]
  assignees    AssignmentAssignee[]
  overrides    AssignmentOverride[]
  /// Send grades to the LMS as they change. Off means faculty send them by hand. Only has any
  /// effect when the course is linked to an LMS.
  ltiAutoSync  Boolean         @default(true)
  ltiLineItems LtiLineItem[] // gradebook columns in linked LMS courses
  ltiDeepLinks LtiDeepLink[] // LMS links that open this assignment
  ltiScores    LtiScoreQueue[] // grades queued for an LMS gradebook

  @@index([courseId])
  @@index([isPublished])
  @@index([dueDate])
  @@index([lateCutoff])
  @@index([courseId, isPublished])
  @@index([groupSetId])
}

/// Who an assignment is for, when it is not for the whole class. Each row names one student or
/// one group. Rows carry no dates: changing who is assigned and changing someone's deadline are
/// separate concerns, so one never disturbs the other.
///
/// @namespace Assignments
model AssignmentAssignee {
  /// Unique identifier.
  id         String             @id @default(cuid())
  /// Whether this row names a student or a group.
  targetType OverrideTargetType

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// The assignment.
  assignmentId String

  user   User?   @relation("AssigneeTarget", fields: [userId], references: [id], onDelete: Cascade)
  /// The assigned student, when the target is a student.
  userId String?

  studentGroup StudentGroup? @relation("AssigneeGroupTarget", fields: [groupId], references: [id], onDelete: Cascade)
  /// The assigned group, when the target is a group.
  groupId      String?

  /// When this record was created.
  createdAt DateTime @default(now())
  /// When this record was last changed.
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, userId]) // at most one assignee row per (assignment, student)
  @@unique([assignmentId, groupId]) // at most one per (assignment, group)
  @@index([userId])
  @@index([groupId])
}

/// A date or late-policy exception for one student or one group on one assignment. This is only
/// ever about when, never about who. Any field left empty inherits the assignment's own value,
/// so an override can move a due date and leave the late policy alone.
///
/// @namespace Assignments
model AssignmentOverride {
  /// Unique identifier.
  id         String             @id @default(cuid())
  /// Whether this exception applies to a student or a group.
  targetType OverrideTargetType

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// The assignment being excepted.
  assignmentId String

  user   User?   @relation("OverrideTarget", fields: [userId], references: [id], onDelete: Cascade)
  /// The student the exception is for, when the target is a student.
  userId String?

  // GROUP target: the StudentGroup this override applies to (all its members).
  studentGroup StudentGroup? @relation("OverrideGroupTarget", fields: [groupId], references: [id], onDelete: Cascade)
  /// The group the exception is for, when the target is a group.
  groupId      String?

  /// Replacement availability date. Empty inherits the assignment's.
  unlockAt             DateTime?
  /// Replacement due date. Empty inherits the assignment's.
  dueDate              DateTime?
  /// Replacement late cutoff. Empty inherits the assignment's.
  lateCutoff           DateTime?
  /// Replacement late policy. Empty inherits the assignment's.
  allowLateSubmissions Boolean?

  // Nullable + SetNull so deleting the staff account that created an override does not
  // block user deletion (same pattern as ActivityLog). The durable actor identity is in
  // the activity log, not this column.
  createdBy   User?    @relation("OverrideCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// The staff member who granted the exception.
  createdById String?
  /// When this record was created.
  createdAt   DateTime @default(now())
  /// When this record was last changed.
  updatedAt   DateTime @updatedAt

  @@unique([assignmentId, userId]) // at most one override per (assignment, student)
  @@unique([assignmentId, groupId]) // future: at most one per (assignment, group)
  @@index([userId])
  @@index([groupId])
}

/// A single exercise a student solves: a finite automaton, regular expression, grammar,
/// pushdown automaton or Turing machine. Problems belong to a course and can be reused across
/// its assignments.
///
/// @namespace Assignments
/// @erd Submissions
/// @erd System
model Problem {
  /// Unique identifier.
  id                String            @id @default(cuid())
  /// Problem name as students see it.
  title             String
  // Legacy plain-text description. Stays the source of truth for PLAIN_TEXT rows and holds
  // derived plain text for TIPTAP_JSON rows, so legacy clients keep getting plain text.
  /// The problem statement, as plain text.
  description       String?
  /// Whether the statement is plain text or formatted.
  descriptionFormat DescriptionFormat @default(PLAIN_TEXT)
  /// Formatted statement, when the problem uses rich text.
  descriptionJson   Json?
  /// Stored reference solution file.
  fileName          String?
  /// Name of the reference file as uploaded, for display.
  originalFileName  String?

  /// The same two fingerprints a submission carries, taken over the reference solution. A
  /// submission matching either of these IS the posted answer, which the Similarity tab says
  /// out loud: it is a very different situation from two students matching each other.
  answerContentHash String?
  answerShapeHash   String?
  /// What kind of problem this is: finite automaton, regular expression, grammar, pushdown automaton or Turing machine.
  type              ProblemType?
  // FA/PDA state cap and FA determinism are intrinsic to the problem definition.
  /// Largest number of states a solution may use. Empty means no limit.
  maxStates         Int?
  /// Whether the solution must be deterministic.
  isDeterministic   Boolean?
  // NOTE: maxPoints / maxSubmissions / autograderEnabled are per-assignment and live on
  // AssignmentProblem (a problem can be worth different points, allow a different number
  // of submissions, or be autograded in one assignment but not another). They are NOT here.

  /// When this record was created.
  createdAt DateTime @default(now())
  /// When this record was last changed.
  updatedAt DateTime @updatedAt

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// The course this problem belongs to.
  courseId String

  assignments  AssignmentProblem[]
  comments     Comment[]
  activityLogs ActivityLog[]

  @@index([courseId])
  @@index([type])
  @@index([createdAt])
}

/// The appearance of one problem on one assignment, with the settings that apply there: how
/// much it is worth and how many attempts are allowed. The same problem can appear on more than
/// one assignment with different settings.
///
/// @namespace Assignments
/// @erd Submissions
model AssignmentProblem {
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// The assignment.
  assignmentId String
  problem      Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  /// The problem appearing on it.
  problemId    String

  // Per-assignment configuration
  /// What this problem is worth on this assignment.
  maxPoints         Float   @default(0)
  /// How many attempts a student gets. Zero or less means unlimited.
  maxSubmissions    Int     @default(1)
  /// Whether attempts are graded automatically.
  autograderEnabled Boolean @default(true)

  submissions Submission[]
  grades      AssignmentProblemGrade[]
  grants      SubmissionGrant[]

  @@id([assignmentId, problemId])
  @@index([assignmentId])
}

/// Extra attempts given to one student or one group on one problem, over and above the limit
/// everyone else has. Recorded as its own entry rather than by raising the shared limit, so the
/// shared limit stays put and there is a lasting record of who granted what to whom.
///
/// @namespace Assignments
model SubmissionGrant {
  /// Unique identifier.
  id         String             @id @default(cuid())
  /// Whether the extra attempts go to a student or a group.
  targetType OverrideTargetType

  assignmentProblem AssignmentProblem @relation(fields: [assignmentId, problemId], references: [assignmentId, problemId], onDelete: Cascade)
  /// The assignment.
  assignmentId      String
  /// The problem the extra attempts apply to.
  problemId         String

  // STUDENT target: the student this grant applies to.
  user   User?   @relation("SubmissionGrantTarget", fields: [userId], references: [id], onDelete: Cascade)
  /// The student receiving them, when the target is a student.
  userId String?

  // GROUP target: the StudentGroup this grant applies to (its shared submission set).
  studentGroup StudentGroup? @relation("SubmissionGrantGroupTarget", fields: [groupId], references: [id], onDelete: Cascade)
  /// The group receiving them, when the target is a group.
  groupId      String?

  /// How many additional attempts were granted. Always positive; granting again to the same
  /// target adds to this number.
  extraSubmissions Int
  /// Why the extra attempts were granted, for the record.
  reason           String?

  // Nullable + SetNull so deleting the staff account that granted does not block user
  // deletion (same pattern as AssignmentOverride). The durable actor identity is in the
  // activity log, not this column.
  createdBy   User?    @relation("SubmissionGrantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// The staff member who granted them.
  createdById String?
  /// When this record was created.
  createdAt   DateTime @default(now())
  /// When this record was last changed.
  updatedAt   DateTime @updatedAt

  @@unique([assignmentId, problemId, userId]) // at most one grant row per (problem, student)
  @@unique([assignmentId, problemId, groupId]) // at most one grant row per (problem, group)
  @@index([userId])
  @@index([groupId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Group Sets. A course has many group sets; a group set has many groups; a group
// has many student members. A student belongs to at most one group within a given
// set, but may belong to groups in different sets. Assignments can target groups in
// a set (see Assignment.groupSetId) for group submissions.
// ─────────────────────────────────────────────────────────────────────────────

/// A named way of dividing a course into groups, for example "Project teams" or "Lab partners".
/// A course can have several, and an assignment chooses at most one. Once work has been
/// submitted or graded against a set, its groups are frozen so that changing them cannot alter
/// records after the fact.
///
/// @namespace Courses
/// @erd Assignments
model GroupSet {
  /// Unique identifier.
  id   String @id @default(cuid())
  /// Name of the set, for example "Project teams".
  name String

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// The course the set belongs to.
  courseId String

  /// When this record was created.
  createdAt DateTime @default(now())
  /// When this record was last changed.
  updatedAt DateTime @updatedAt

  /// When this set's groups were frozen. Set automatically the first time work is submitted or
  /// graded against an assignment using the set, and never cleared, so group changes cannot alter
  /// records after the fact. Renaming and duplicating remain allowed.
  lockedAt DateTime?

  groups      StudentGroup[]
  assignments Assignment[]

  // Unique set name per course. Case-insensitive + trimmed uniqueness is enforced
  // in the service layer (this DB constraint is the exact-match backstop).
  @@unique([courseId, name])
  @@index([courseId])
}

/// One group inside a group set. Members submit and are graded together on any assignment that
/// uses the set.
///
/// @namespace Courses
/// @erd Assignments
/// @erd Submissions
model StudentGroup {
  /// Unique identifier.
  id   String @id @default(cuid())
  /// Group name as members see it.
  name String

  groupSet   GroupSet @relation(fields: [groupSetId], references: [id], onDelete: Cascade)
  /// The set this group belongs to.
  groupSetId String

  /// When this record was created.
  createdAt DateTime @default(now())
  /// When this record was last changed.
  updatedAt DateTime @updatedAt

  memberships         GroupMembership[]
  assignmentAssignees AssignmentAssignee[]     @relation("AssigneeGroupTarget")
  assignmentOverrides AssignmentOverride[]     @relation("OverrideGroupTarget")
  submissionGrants    SubmissionGrant[]        @relation("SubmissionGrantGroupTarget")
  submissions         Submission[]
  comments            Comment[]                @relation("CommentsAboutGroup")
  groupGrades         AssignmentProblemGrade[] @relation("GroupGradedMembers")

  // Unique group name within its set (case-insensitive + trimmed in the service
  // layer). Different sets may reuse the same group names.
  @@unique([groupSetId, name])
  // Composite target so a membership can prove its group belongs to its set at
  // the database level.
  @@unique([id, groupSetId])
  @@index([groupSetId])
}

/// A student's place in one group. A student belongs to at most one group per set, so their
/// group is unambiguous for any assignment using it.
///
/// @namespace Courses
model GroupMembership {
  /// Unique identifier.
  id String @id @default(cuid())

  /// The set the group belongs to.
  groupSetId String

  // The group is bound to its set through a composite reference, so the database
  // rejects any membership whose group lives in a different set.
  group   StudentGroup @relation(fields: [groupId, groupSetId], references: [id, groupSetId], onDelete: Cascade)
  /// The group joined.
  groupId String

  // The member must be a roster row in the course (the service layer always sets
  // courseId from the set, and eligibility additionally requires role STUDENT, an
  // active account, and ENROLLED status). This composite reference to Roster is the
  // database-level "has a roster row here" guard; note it does NOT enforce status, so
  // a dropped student keeps their membership row until re-enrolled (by design).
  roster   Roster @relation(fields: [courseId, userId], references: [courseId, userId], onDelete: Cascade)
  /// The course, carried here so membership can be checked per course.
  courseId String
  /// The student.
  userId   String

  /// When this record was created.
  createdAt DateTime @default(now())
  /// When this record was last changed.
  updatedAt DateTime @updatedAt

  // The concurrency-critical guarantee: a student can hold at most one group per
  // set even under two simultaneous assign requests.
  @@unique([groupSetId, userId])
  @@index([groupId, groupSetId])
  @@index([courseId, userId])
  @@index([userId])
}

/// One attempt at one problem: the file the student sent, its progress through the grading
/// queue, and the result. Submissions are kept rather than replaced, so earlier attempts remain
/// available.
///
/// @namespace Submissions
/// @erd System
model Submission {
  /// Unique identifier.
  id            String   @id @default(cuid())
  /// Feedback produced for this attempt.
  feedback      String?
  /// Whether the attempt was judged correct. Empty until grading finishes.
  correct       Boolean?
  /// Full grader output, kept for diagnosis.
  evaluationRaw Json?

  /// Stored submitted file.
  fileName         String?
  /// Name of the file as the student sent it.
  originalFileName String?

  /// sha256 of the submitted file's normalised content, written by the server when the file
  /// arrives (both the browser and the native client). Two submissions of the same file
  /// carry the same value, which is what the Similarity tab groups on. Empty for a
  /// submission with no file, and for everything submitted before this column existed.
  ///
  /// On its own it means "these are the same file", never "somebody copied": students
  /// converge on the same right answer, and a grammar or regular expression has no layout
  /// to differ in. What carries meaning is how rare a value is within one problem.
  contentHash String?

  /// sha256 of the same file with everything incidental removed: where the states sit, what
  /// they are called, the order things were written in. Two submissions sharing this are the
  /// same machine drawn differently, which is what a copied file looks like once somebody
  /// has dragged the nodes about. Empty for a regular expression, which has no layout, and
  /// for anything that could not be parsed.
  shapeHash String?

  /// A small description of the submitted artifact in pieces: local structure, the state
  /// identifiers JFLAP assigns behind the visible names, where states sit relative to each
  /// other, and any hand-adjusted transition curves. It exists so a copied file that has
  /// since been edited can still be recognised, which neither hash above can do. Carries its
  /// own version, so the rules can change without old rows becoming ambiguous.
  ///
  /// Never a similarity score, and never a copy of the file: a description of it.
  provenanceFeatures Json?

  /// When this record was created.
  createdAt DateTime @default(now())
  /// When this record was last changed.
  updatedAt DateTime @updatedAt

  assignmentProblem AssignmentProblem @relation(fields: [assignmentId, problemId], references: [assignmentId, problemId], onDelete: Cascade)

  /// The assignment.
  assignmentId String
  /// The problem attempted.
  problemId    String

  // For individual submissions this is the submitting student
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// The student who submitted.
  studentId String

  // Course reference
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// The course, carried here so a student's work can be found per course.
  courseId String

  // Set for a group submission: the StudentGroup that owns this submission set. Any
  // member's submit writes the group here; individual submissions leave it null. The
  // submitting member is still recorded in studentId.
  studentGroup   StudentGroup? @relation(fields: [studentGroupId], references: [id], onDelete: SetNull)
  /// The group the work counts for, on a group assignment.
  studentGroupId String?

  // Queue
  /// Where the attempt is: waiting, being graded, finished or failed.
  status      SubmissionStatus @default(PENDING)
  /// When the student sent the attempt.
  submittedAt DateTime         @default(now())
  /// How many times grading has been tried for this attempt.
  attempts    Int              @default(0) // Number of times the worker has claimed this submission
  /// Who owns this row while it is being evaluated: a fresh random value on every claim,
  /// cleared when the evaluation lands or the submission is put back on the queue.
  ///
  /// The fence every post-claim write is conditioned on. `attempts` used to serve and could
  /// not: a rerun resets it to 0, the next claim takes it back to 1, and a worker still
  /// evaluating the older attempt matched again and overwrote the newer result. A random token
  /// never comes back round, so a worker that has lost the row can never write to it again.
  processingToken String?

  // Logs
  activityLogs ActivityLog[]

  @@index([assignmentId])
  @@index([studentId])
  @@index([courseId])
  @@index([studentGroupId])
  @@index([assignmentId, problemId, studentId])
  // Group submission set + cap counting for a group.
  @@index([assignmentId, problemId, studentGroupId])
  // Matching submissions that are the same file. Always read per problem, never globally:
  // a match only means something among students answering the same question, and a
  // course-wide or system-wide search would show staff work from courses they do not teach.
  @@index([problemId, contentHash])
  @@index([problemId, shapeHash])
  // Performance indexes
  @@index([assignmentId, problemId])
  @@index([studentId, courseId, assignmentId, problemId, submittedAt])
  // Hot path for the submission queue worker's claim query
  @@index([status, submittedAt])
  @@index([status])
  // The Autograder page pages through submissions newest-first, narrowed by problem or
  // course. Each of these covers one scope level plus the sort, so a page is an index
  // scan rather than a sort of the whole table.
  @@index([problemId, submittedAt])
  @@index([courseId, submittedAt])
  @@index([submittedAt])
}

/// A student's grade on one problem of one assignment. A grade set by hand by a staff member is
/// marked as such, and automatic grading will not overwrite it.
///
/// @namespace Submissions
model AssignmentProblemGrade {
  /// Unique identifier.
  id       String  @id @default(cuid())
  /// Points awarded.
  grade    Float
  /// Comment recorded with the grade.
  feedback String?

  /// Whether this grade is held against automatic grading. Re-running the grader skips a held
  /// grade, so it cannot undo a person's decision.
  ///
  /// This is a hold, NOT a record of who graded. It starts true for every hand-entered grade,
  /// but staff can release one (handing it back to the grader) or hold an autograded one, and
  /// after either the flag says nothing about where the number came from. Use `gradeSource`
  /// for that.
  gradedManually Boolean @default(false)

  /// Who produced the number: `AUTOGRADER` or `MANUAL`. Separate from the hold above because
  /// the two come apart: a released manual grade is still a manual grade, and a held
  /// autograded one is still the autograder's. Reading the hold as provenance told a grader
  /// who had released their own grade that "the autograder set this grade".
  ///
  /// The three hand-grading routes write `MANUAL`; the submission worker writes `AUTOGRADER`,
  /// including when it overwrites a released grade, because at that point the number is its
  /// own. `lib/grade-hold.ts` is the only place that turns this into words for a screen.
  gradeSource GradeSource @default(AUTOGRADER)

  /// When this record was created.
  createdAt DateTime @default(now())
  /// When this record was last changed.
  updatedAt DateTime @updatedAt

  assignmentProblem AssignmentProblem @relation(fields: [assignmentId, problemId], references: [assignmentId, problemId], onDelete: Cascade, onUpdate: Cascade)
  /// The assignment.
  assignmentId      String
  /// The problem graded.
  problemId         String

  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// The student graded.
  studentId String

  // Grading a group writes one of these rows per member, so every reader (the gradebook,
  // the CSV export, statistics, an LMS carry-back) keeps finding a grade of its own on each
  // student and needs to know nothing about groups.
  //
  // The two fields below only record where the row came from. Without them "this member's
  // grade differs from their groupmates'" is ambiguous: it could be a deliberate adjustment
  // for uneven contribution, or a group that was simply never graded together. Keeping the
  // applied value makes it exact: adjusted means groupGradeValue is set and grade differs
  // from it. SetNull so deleting a group leaves the grades themselves untouched.
  groupGradeGroup   StudentGroup? @relation("GroupGradedMembers", fields: [groupGradeGroupId], references: [id], onDelete: SetNull)
  /// The group whose group grade produced this row, when it came from one.
  groupGradeGroupId String?
  /// The value that group grade set, so a later individual change reads as an adjustment.
  /// Outlives the group: deleting one nulls the id above but keeps this, so "adjusted away
  /// from 8" stays true afterwards.
  groupGradeValue   Float?

  @@unique([assignmentId, problemId, studentId])
  @@index([groupGradeGroupId])
  @@index([assignmentId, problemId])
  @@index([assignmentId])
  @@index([studentId])
  // The gradebook reads one page of students at a time, so its grade lookup filters
  // studentId IN (the page) AND assignmentId IN (the course). The indexes above all lead
  // with assignmentId or stop at studentId, which leaves that pair unserved.
  @@index([studentId, assignmentId])
}

/// Feedback attached to a student's work, written by staff or by the student.
///
/// @namespace Submissions
model Comment {
  /// Unique identifier.
  id        String   @id @default(cuid())
  /// The comment text.
  content   String
  /// When this record was created.
  createdAt DateTime @default(now())

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// The assignment the comment is about.
  assignmentId String

  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  /// The problem the comment is about.
  problemId String

  // The author is always a User. `roster` is only the author's role WITHIN this
  // course (for the role badge) and is null when the author isn't rostered (e.g. a
  // system admin commenting on a course they aren't enrolled in). We never fabricate a
  // roster row just to attribute a comment.
  author   User   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  /// Who wrote it.
  authorId String

  roster   Roster? @relation(fields: [rosterId], references: [id], onDelete: SetNull)
  /// The commenter's place in the course, recording the role they wrote in.
  rosterId String?

  aboutStudent   User?   @relation("CommentsAboutStudent", fields: [aboutStudentId], references: [id], onDelete: Cascade)
  /// The student the comment concerns, when staff comment on someone's work.
  aboutStudentId String?

  // A comment is addressed to one student OR to a whole group, never both. On a group
  // assignment staff usually mean the group, so the shared submission gets one comment
  // every member sees rather than a copy per member that can drift apart.
  //
  // SetNull, not Cascade: deleting a group must not destroy the feedback written about
  // its work. The comment survives and simply stops being addressed to anyone, which is
  // recoverable; the cascade is not.
  aboutGroup   StudentGroup? @relation("CommentsAboutGroup", fields: [aboutGroupId], references: [id], onDelete: SetNull)
  /// The group the comment concerns, when staff comment on a group's shared work.
  aboutGroupId String?

  @@index([assignmentId])
  @@index([problemId])
  @@index([authorId])
  @@index([rosterId])
  @@index([aboutStudentId])
  @@index([aboutGroupId])
  @@index([assignmentId, problemId, aboutGroupId])
  @@index([assignmentId, problemId])
  @@index([assignmentId, problemId, aboutStudentId])
  @@index([createdAt])
}

/// The record of what happened in the system: who signed in, who changed a grade, who looked at
/// a student's work, and when. It serves both as an audit trail and, because AFCT is used in a
/// multi-institution study, as research data. Entries are kept for a configurable period and
/// then removed.
///
/// @namespace System
model ActivityLog {
  /// Unique identifier.
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Who performed the action. Empty for actions with no signed-in person, such as a failed sign-in.
  userId    String?
  /// What happened.
  action    String
  /// When it happened.
  timestamp DateTime @default(now())
  /// Extra detail about the action.
  metadata  Json?

  /// The course involved, if any.
  courseId     String?
  course       Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  /// The assignment involved, if any.
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  /// The problem involved, if any.
  problemId    String?
  problem      Problem?    @relation(fields: [problemId], references: [id], onDelete: SetNull)
  /// The submission involved, if any.
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  // Additional categorization
  /// Broad grouping the action falls under.
  category  String? // SYSTEM, COURSE, ASSIGNMENT, PROBLEM, SUBMISSION, USER
  /// How significant the entry is.
  severity  LogSeverity @default(INFO)
  /// Address the request came from.
  ipAddress String?
  /// Client that made the request.
  userAgent String?

  // Index strategy for a high-write, admin-read log table. Composites serve
  // "filter by X, order by timestamp desc" in a single scan; single-column
  // indexes that are the leftmost prefix of a composite are omitted to keep
  // insert cost down (e.g. userId is covered by [userId, courseId]).
  @@index([timestamp]) // default System Logs ordering
  @@index([severity, timestamp]) // severity dropdown + timestamp sort
  @@index([action])
  @@index([category])
  @@index([problemId])
  @@index([submissionId])
  @@index([courseId, action])
  // The course Activity tab pages newest-first within one course. Its where is an OR
  // across four relations, so this serves the common courseId branch plus the sort
  // rather than the whole query.
  @@index([courseId, timestamp])
  @@index([assignmentId, action])
  @@index([userId, courseId])
  @@index([timestamp, category])
  @@index([ipAddress, timestamp]) // "what has this address done", System Status + investigations
}

/// Installation-wide settings, held as a single row: the default timezone, sign-up rules,
/// upload and login limits, backup schedule, and grading queue tuning.
///
/// @namespace System
model SystemSettings {
  /// Always 1. Settings are held in a single row.
  id                    Int     @id @default(1)
  /// Default timezone for the installation. New courses start with this.
  timezone              String  @default("UTC")
  /// Largest file a student may upload, in megabytes.
  maxUploadSizeMb       Int     @default(25)
  /// Whether people may create their own accounts. When off, only an administrator can add users.
  allowSignup           Boolean @default(true)
  /// Comma-separated list of email domains allowed to self-register, for example
  /// "psu.edu,example.edu". Blank allows any domain.
  signupAllowedDomains  String  @default("")
  /// How long a session may sit idle before the person is signed out.
  sessionTimeoutMinutes Int     @default(60)

  /// Whether times are shown on a 24-hour clock rather than with AM and PM. Affects display only,
  /// never stored times or deadline enforcement.
  clock24Hour Boolean @default(false)

  /// How many failed sign-in attempts an account may accumulate before it is temporarily locked.
  loginMaxAttempts    Int @default(10)
  /// How long an account stays locked after too many failed sign-in attempts.
  loginLockoutMinutes Int @default(10)

  /// Whether the nightly database backup runs.
  backupEnabled       Boolean @default(true)
  /// Hour of the day, in UTC, at which the nightly backup runs.
  backupHour          Int     @default(2)
  /// How many days of backups to keep before the oldest are removed.
  backupRetentionDays Int     @default(14)

  /// How long activity log entries are kept before they are removed.
  activityLogRetentionDays Int @default(365)

  /// How long a single submission may be graded before it is abandoned, in milliseconds.
  submissionEvalTimeoutMs      Int @default(30000)
  /// Memory ceiling for grading one submission, in megabytes.
  submissionEvalMaxMemoryMb    Int @default(256)
  /// How long a student must wait between attempts at the same problem, in milliseconds.
  submissionResubmitCooldownMs Int @default(10000)
  /// How many submissions may be graded at the same time.
  submissionMaxConcurrent      Int @default(5)
  /// How many times grading is retried before a submission is reported as failed.
  submissionMaxAttempts        Int @default(3)
  /// Exploration bound given to the grammar analyzer when comparing languages.
  submissionAnalyzerLimit      Int @default(15)

  /// Public hCaptcha key used on the sign-in page. Empty falls back to the value supplied by the
  /// environment, and then to having no captcha.
  hcaptchaSiteKey   String?
  /// Private hCaptcha key. Never sent to the browser.
  hcaptchaSecretKey String?

  /// Whether people may sign in with an institutional account. Off until an admin configures a
  /// provider and turns it on, so an install using only local accounts is unchanged.
  oidcEnabled      Boolean @default(false)
  /// The provider's issuer URL. Everything else is discovered from it.
  oidcIssuer       String?
  /// The client id the provider gave for this AFCT install.
  oidcClientId     String?
  /// The client secret. Encrypted at rest (see `lib/secret-encryption`) and never returned to
  /// the browser; the API reports only whether one is stored.
  oidcClientSecret String?
  /// Wording on the sign-in button, so it can say what the institution calls its login.
  oidcButtonLabel  String?
  /// Whether to treat this provider's email claim as verified even when it does not say so.
  ///
  /// Off by default, and deliberately per-provider rather than global. Auto-linking normally
  /// requires an asserted `email_verified`, but Entra and Azure AD frequently omit that claim
  /// altogether, and they are what most campuses run. Without this switch auto-linking would
  /// silently never fire at those institutions; with it on for a provider that lets people
  /// choose their own address, an email becomes a way to reach somebody else's account. Hence
  /// an explicit, logged decision by an administrator rather than a default either way.
  oidcTrustEmail   Boolean @default(false)

  /// Whether somebody who signs in through an institution or an LMS may also set an AFCT
  /// password for themselves.
  ///
  /// On by default, which is what every install does today. An institution that requires its
  /// own sign-in (and the multi-factor rules that come with it) can turn it off, so a second
  /// way into an account cannot be added without them. Deliberately narrow: it governs
  /// self-service only, never an administrator or a faculty member setting a password for
  /// somebody, because that is the way back in when nothing else works and an install must not
  /// be able to configure itself into having none.
  allowLinkedAccountPasswords Boolean @default(true)

  /// Whether AFCT may send email at all. Off until an admin configures a server and turns it
  /// on, so an install that does not want mail behaves exactly as it did before.
  smtpEnabled     Boolean      @default(false)
  /// Mail server hostname.
  smtpHost        String?
  /// Mail server port. 587 with STARTTLS is the usual institutional answer.
  smtpPort        Int?
  smtpSecurity    SmtpSecurity @default(STARTTLS)
  /// Username for the mail server, when it requires one.
  smtpUsername    String?
  /// Password for the mail server. Encrypted at rest (see `lib/secret-encryption`) and never
  /// returned to the browser; the API reports only whether one is stored.
  smtpPassword    String?
  /// Address mail is sent from. Institutions usually require this to be one they host.
  smtpFromAddress String?
  /// Display name shown beside the from address.
  smtpFromName    String?

  /// When this record was created.
  createdAt DateTime @default(now())
  /// When this record was last changed.
  updatedAt DateTime @updatedAt
}

/// Which AFCT course an LMS course opens into.
///
/// Created the first time somebody who can link launches from an unlinked LMS course, and
/// remembered afterwards so nobody is asked twice.
///
/// **Many LMS courses may point at one AFCT course.** Cross-listed sections are separate courses
/// in the LMS and one course to the department, and forcing them apart would split one roster in
/// two. The reverse is refused by the unique constraint: one LMS course opening two AFCT courses
/// has no answer to "which one did they mean".
///
/// @namespace LTI
model LtiContextLink {
  /// Unique identifier.
  id String @id @default(cuid())

  platform   LtiPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  /// Which registration the launch came through.
  platformId String

  /// The LMS's own identifier for its course, from the launch's context claim.
  contextId    String
  /// What the LMS calls it, kept for screens so an admin can recognise a link.
  contextTitle String?

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// The AFCT course it opens.
  courseId String

  /// Where to create gradebook columns for this LMS course, from the launch's AGS claim.
  /// Null when the platform granted no grade scopes. Refreshed on each launch.
  lineItemsUrl String?

  /// Where to read this LMS course's membership, from the launch's NRPS claim. Null when the
  /// platform granted no roster scope. Refreshed on each launch.
  membershipsUrl String?

  /// Who AFCT has seen in this LMS course.
  members LtiContextMember[]

  linkedBy   User?   @relation(fields: [linkedByUserId], references: [id], onDelete: SetNull)
  /// Who decided this. Null once that account is gone; the link outlives the person.
  linkedByUserId String?

  /// When this record was created.
  createdAt DateTime @default(now())

  /// Gradebook columns created in this LMS course.
  lineItems LtiLineItem[]

  /// Assignments already added to this LMS course as a link.
  deepLinks LtiDeepLink[]

  /// One AFCT course per LMS course. Not the other way round: see the note above.
  @@unique([platformId, contextId])
  @@index([courseId])
}

/// A launch that arrived from an LMS course nobody has linked yet, waiting for someone to say
/// which AFCT course it is.
///
/// The launch details live here rather than travelling through the browser in a URL. If they
/// were in the URL, faculty could edit the LMS course identifier and pre-link a *different*
/// LMS course to their own AFCT course, capturing every launch from it afterwards. Held here,
/// the identifier is the one the platform actually signed.
///
/// Short-lived, and scoped to the person the launch signed in: this is a step in a flow, not a
/// record of anything.
///
/// @namespace LTI
model LtiPendingLink {
  /// Unique identifier, and what the browser is handed to name this pending link.
  id String @id @default(cuid())

  platform   LtiPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  /// Which registration the launch came through.
  platformId String

  /// The LMS's own identifier for its course, exactly as the platform signed it.
  contextId    String
  /// What the LMS calls it, shown on the picker so faculty know what they are linking.
  contextTitle String?

  /// Where grades and the roster are read and written for this course, carried from the launch
  /// that offered the link.
  ///
  /// They have to travel with the pending row because only a launch is given them: they arrive
  /// as claims in the signed token, and the browser that comes back to choose a course a minute
  /// later brings nothing. Without them the link was stored with both set to null, and grades
  /// then failed against a message blaming the LMS for permissions it had already granted.
  lineItemsUrl   String?
  membershipsUrl String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Who the launch signed in. Only they can act on it.
  userId String

  /// When this stops being usable.
  expiresAt DateTime
  /// When this record was created.
  createdAt DateTime @default(now())

  @@index([userId])
  /// Expired rows are swept with the other short-lived tokens.
  @@index([expiresAt])
}

/// One AFCT assignment's gradebook column in an LMS course.
///
/// Created on demand the first time a grade is sent, and remembered so later grades go to the
/// same column instead of making a new one each time.
///
/// @namespace LTI
model LtiLineItem {
  /// Unique identifier.
  id String @id @default(cuid())

  contextLink   LtiContextLink @relation(fields: [contextLinkId], references: [id], onDelete: Cascade)
  /// The LMS course this column lives in.
  contextLinkId String

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// The AFCT assignment it scores.
  assignmentId String

  /// The platform's URL for this column, used to post scores.
  url String

  /// What the column was last told it is called and worth. Kept so a renamed assignment, or one
  /// whose points changed, can be corrected in the LMS: a score is scaled against the column's
  /// maximum, so a stale one silently misreports every grade.
  label        String?
  scoreMaximum Float?

  /// When this record was created.
  createdAt DateTime @default(now())

  /// One column per assignment per LMS course.
  @@unique([contextLinkId, assignmentId])
  @@index([assignmentId])
}

/// Where a grade is on its way to the LMS.
enum LtiScoreState {
  /// Waiting to be sent, or waiting to be retried.
  PENDING
  /// The LMS accepted it.
  SENT
  /// Given up on. Needs somebody to look.
  FAILED
}

/// A grade on its way to an LMS gradebook.
///
/// Written in the same breath as the grade itself and sent afterwards, rather than posted
/// inline. An LMS that is slow, down or rate-limiting must never make grading fail or hang, and
/// a grade that did not arrive has to be visible rather than lost in a log.
///
/// One row per assignment per student: a regrade replaces the pending row instead of queueing a
/// second, so the LMS receives the current grade rather than a history of edits.
///
/// @namespace LTI
model LtiScoreQueue {
  /// Unique identifier.
  id String @id @default(cuid())

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// The assignment being scored.
  assignmentId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The student whose grade this is.
  userId String

  /// The grade, and what it is out of, captured when it was queued.
  scoreGiven   Float
  scoreMaximum Float

  state LtiScoreState @default(PENDING)
  /// How many times sending has been tried. Drives the backoff and the give-up point.
  attempts Int @default(0)

  /// Which send owns this row, as a random value written when a sender claims it.
  ///
  /// A sender that finishes must only record its own outcome. Without this, a grade changed
  /// while a send was in flight was overwritten by that send's result: the queue row is reused
  /// for the new grade, so the old sender marked the *new* score SENT and logged it as
  /// delivered, while the LMS held the old one and nothing ever sent the new one. A counter
  /// cannot fix it, because re-queuing resets the counter to a value a live sender still holds;
  /// a random token never comes round again. Cleared when the row is re-queued, which is what
  /// fences the sender that is still running.
  claimToken String?
  /// Why the last attempt failed, for the screen that shows faculty what happened.
  lastError String?

  /// Not before this time. Set into the future to back off after a failure.
  nextAttemptAt DateTime @default(now())
  /// When the LMS accepted it.
  sentAt        DateTime?

  /// When this record was created.
  createdAt DateTime @default(now())
  /// When it was last changed.
  updatedAt DateTime @updatedAt

  /// One pending grade per student per assignment; a regrade replaces it.
  @@unique([assignmentId, userId])
  /// What the sender reads: everything due, oldest first.
  @@index([state, nextAttemptAt])
}

/// A deep-linking request waiting for somebody to choose an assignment.
///
/// The return URL and the platform's opaque state are held here rather than passed through the
/// browser. In a URL, somebody could change where AFCT posts its signed answer, and AFCT signs
/// that answer with its own key.
///
/// @namespace LTI
model LtiPendingDeepLink {
  /// Unique identifier, and what the browser is handed to name this pending choice.
  id String @id @default(cuid())

  platform   LtiPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  /// Which registration asked.
  platformId String

  /// The LMS course it was asked from, so the picker can offer that course's assignments.
  contextId String?

  /// Where the signed answer is posted, exactly as the platform gave it.
  returnUrl String
  /// The platform's own opaque state, returned untouched or the response is rejected.
  data      String?

  /// What the platform said it will accept, from the deep linking settings claim. Required by
  /// Deep Linking 2.0, so never empty: a request without it is refused at launch.
  acceptTypes                       String[]
  /// How the platform is prepared to display what it is given. Also required by Deep Linking
  /// 2.0. AFCT has nothing to decide from it yet and keeps it anyway, because dropping a
  /// required part of the request would make it unrecoverable if that ever changes.
  acceptPresentationDocumentTargets String[]
  /// Whether a gradebook column may come with the link. Three states, and null is the important
  /// one: Deep Linking 2.0 says that when accept_lineitem is absent "no assumption can be made
  /// about the support of line items", so it is not the same as true and AFCT sends a line item
  /// only when the platform has said so outright.
  acceptLineItem                    Boolean?
  /// Whether the platform will take more than one item back, with null for a request that did
  /// not say. AFCT returns one assignment per response, so this changes nothing today; it is
  /// stored because it is the platform's own statement of what it supports, and multi-assignment
  /// selection would need it.
  acceptMultiple                    Boolean?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Who the launch signed in. Only they can answer it.
  userId String

  /// When this stops being usable.
  expiresAt DateTime
  /// When this record was created.
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// One LTI launch, from the login the platform initiates to the token it posts back.
///
/// The state and the nonce used to be two unrelated single-use tokens, which proved each was
/// AFCT's and unspent but never that they belonged to the same launch. Holding them on one row
/// with the platform and the target link URI is what lets the returning token be checked
/// against the login that started it, which LTI Core requires and which two loose tokens
/// cannot express. Consuming the row is also the single point at which a launch is spent.
///
/// @namespace LTI
model LtiLaunchTransaction {
  /// Unique identifier.
  id String @id @default(cuid())

  /// sha256(state), never the plaintext. The value handed to the browser and posted back.
  stateHash String @unique
  /// sha256(nonce), never the plaintext. The value the platform copies into the id_token.
  nonceHash String @unique

  platform   LtiPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  /// The registration this launch was started against; the token must match it.
  platformId String

  /// The target link URI the platform sent to the login endpoint, when it sent one. Core says
  /// the signed token's own target link URI must equal this.
  targetLinkUri String?

  /// The frame the platform named for its browser storage, when it offered any.
  ///
  /// Set from `lti_storage_target` at login. Its presence is what says this platform can hold a
  /// value for AFCT in the browser, which is the only route left when a browser refuses the
  /// state cookie outright. Absent means cookies are the only mechanism available.
  storageTarget String?

  /// The signed token, held only while a launch waits for the browser to answer for its state.
  ///
  /// A launch that arrives without its cookie cannot be finished on that request: the answer is
  /// in the platform's browser storage and only a page can read it. Rather than hand the token
  /// back through the browser to be posted again, it waits here for the seconds that takes, and
  /// is cleared the moment the launch is spent or expires.
  idToken String?

  /// When the launch stops being completable.
  expiresAt DateTime
  /// When it was spent. Once set, the launch is refused as a replay.
  usedAt    DateTime?
  /// When this record was created.
  createdAt DateTime  @default(now())

  @@index([platformId])
  /// Expired rows are swept periodically; this is the index that sweep reads.
  @@index([expiresAt])
}

/// Which LMS course a person is in, so a grade goes to the right gradebook.
///
/// One AFCT course can be opened from several LMS courses (cross-listed sections). Without
/// this, grade passback had to guess: it tried each link in turn and let the platform refuse
/// the wrong ones, but the first thing it does is create a gradebook column, so a student from
/// one section could put an AFCT column in another, and a student in both got their grade
/// wherever the query happened to order first. Recorded on every launch and on every roster
/// sync, which are the two moments the LMS tells AFCT who is in which course.
///
/// @namespace LTI
model LtiContextMember {
  /// Unique identifier.
  id String @id @default(cuid())

  contextLink   LtiContextLink @relation(fields: [contextLinkId], references: [id], onDelete: Cascade)
  /// The LMS course this membership is in.
  contextLinkId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The AFCT account.
  userId String

  /// The LMS's own id for this person in this context, which is what a score is posted against.
  ltiUserId String

  /// When AFCT last saw evidence they belong here, from a launch or a roster read.
  seenAt DateTime @default(now())

  /// One row per person per LMS course; seeing them again updates it rather than adding.
  @@unique([contextLinkId, userId])
  @@index([userId])
}

/// Whether a queued message has gone out yet.
enum MailState {
  /// Waiting to be sent, or waiting to be retried.
  PENDING
  /// The mail server accepted it.
  SENT
  /// Given up on. Needs somebody to look.
  FAILED
}

/// A message waiting to go out.
///
/// The password-reset endpoint must answer in the same time whether or not the address has an
/// account, and it cannot do that while it is holding a TCP connection open to a mail server.
/// Queueing turns a variable multi-second SMTP conversation into a row insert, which is what
/// closes the timing side channel: the work that differs between the two cases now happens after
/// the response has gone.
///
/// @namespace System
model MailQueue {
  /// Unique identifier.
  id String @id @default(cuid())

  /// Who it goes to. Not a foreign key: the queue outlives the reason it was made, and a reset
  /// for an address with no account is never queued at all.
  toAddress String
  subject   String

  /// The body, encrypted at rest with the same key as the other stored secrets.
  ///
  /// A reset link is a working key to somebody's account for as long as it lasts, so it must not
  /// sit in a table in plain text where a backup or a stray query would expose it. The plaintext
  /// exists in memory for as long as it takes to hand to the mail server.
  bodyEncrypted String

  /// sha256 of the single-use token this message carries, when it carries one.
  ///
  /// Not a secret: the same hash is already the only stored form of the token. It is here so a
  /// retry can check the token is still unspent and unexpired before sending, rather than
  /// mailing somebody a link that stopped working an hour ago.
  tokenHash String?

  state MailState @default(PENDING)
  /// How many times sending has been tried. Drives the backoff and the give-up point.
  attempts Int @default(0)
  /// Why the last attempt failed. Sanitised: never a password, never a token.
  lastError String?

  /// Not before this time. Set into the future to back off after a failure.
  nextAttemptAt DateTime @default(now())
  /// When the mail server accepted it.
  sentAt        DateTime?

  /// When this record was created.
  createdAt DateTime @default(now())
  /// When it was last changed.
  updatedAt DateTime @updatedAt

  /// The order the sender reads in.
  @@index([state, nextAttemptAt])
}

/// Where a staff evaluator trial has got to. Mirrors SubmissionStatus, but kept separate
/// so the two queues can diverge without one changing the meaning of the other's rows.
enum EvaluatorTrialState {
  /// Waiting for a worker.
  PENDING
  /// A worker has it.
  PROCESSING
  /// The evaluator returned a verdict.
  COMPLETED
  /// The evaluator could not produce one.
  FAILED
}

/// A staff dry run of the evaluator: an answer file and a submitted file, run through the
/// real jar, with no grade attached to the result.
///
/// Deliberately not a Submission. That table is what grades are computed from, and its
/// foreign keys require an assignment, a problem and a student, none of which a trial has.
///
/// The uploads are usually a real student's work, being re-run to reproduce a grading
/// complaint, so they are education records even though staff uploaded them. Keeping them
/// would create a second store of student work outside the submission system and outside
/// the access controls around it. That is why the files are deleted the moment the run
/// ends and the row itself expires: it is a safety property, not housekeeping.
///
/// @namespace System
model EvaluatorTrial {
  /// Unique identifier.
  id String @id @default(cuid())

  /// The staff member who asked for the run. Only they (and admins) can read it back.
  requestedBy   User   @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  /// Who asked for it.
  requestedById String

  /// Which mode to run the evaluator in. The CLI arguments differ by type: FA and PDA
  /// carry a state bound, and FA a determinism flag as well.
  problemType     ProblemType
  /// State bound for FA/PDA, as on the problem itself. Empty means unbounded.
  maxStates       Int?
  /// Whether an FA answer must be deterministic.
  isDeterministic Boolean?

  /// Stored upload names under the trials directory. Cleared when the files are deleted,
  /// which is what tells the orphan sweep it has nothing left to remove for this row.
  answerFileName         String?
  submissionFileName     String?
  /// What the uploader called the files, kept for display after the uploads are gone.
  answerOriginalName     String
  submissionOriginalName String

  /// Where the run has got to.
  state EvaluatorTrialState @default(PENDING)

  /// Whether the evaluator judged the submitted file correct. Empty until it finishes.
  correct       Boolean?
  /// The evaluator's feedback, or the reason it produced none.
  feedback      String?
  /// Full evaluator output, which is the point of the page.
  evaluationRaw Json?
  /// Anything the jar wrote to stderr, shown as a diagnostic.
  stderr        String?
  /// How long the jar ran, in milliseconds.
  durationMs    Int?

  /// When this record was created.
  createdAt   DateTime  @default(now())
  /// When a worker claimed it.
  startedAt   DateTime?
  /// When it finished, either way.
  completedAt DateTime?
  /// When the row itself may be removed. See the note above: results are short-lived on
  /// purpose, so a trial is never a lasting copy of somebody's work.
  expiresAt   DateTime
  /// When this record was last changed.
  updatedAt   DateTime  @updatedAt

  /// The order a worker claims trials in, oldest first.
  @@index([state, createdAt])
  /// The per-user cap: how many trials this person already has running.
  @@index([requestedById, state])
  /// The expiry sweep.
  @@index([expiresAt])
}


/// A launch that matched an AFCT administrator, waiting for them to prove it is them.
///
/// An administrator account is never attached to an LMS identity automatically, because the
/// match rests on an email the LMS asserts, and AFCT cannot see how carefully that address was
/// verified. For a student that would expose one person's work; for an administrator it would
/// hand over every student record in the system.
///
/// Refusing outright left them nowhere to go, so the launch pauses here instead: they type
/// their AFCT password, which is the one thing an LMS cannot assert, and the link is then a
/// deliberate act rather than an automatic one. Short-lived, single use, and useless to
/// anybody who cannot also sign in as that account.
/// @namespace LTI
model LtiPendingIdentityLink {
  /// Unique identifier, and what the browser is handed to name this pending confirmation.
  id String @id @default(cuid())

  /// The platform's issuer and its own id for the person, exactly as the launch signed them.
  /// Stored rather than re-derived: the confirmation must attach the identity that launched,
  /// not whatever a later request claims.
  issuer  String
  subject String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The administrator account the launch matched by email.
  userId String

  /// Where the launch was headed, so confirming lands them where they were going.
  next String?

  /// When this stops being usable.
  expiresAt DateTime
  /// When this record was created.
  createdAt DateTime @default(now())

  /// The expiry sweep.
  @@index([expiresAt])
}

/// An AFCT assignment somebody added to an LMS course as a link.
///
/// Written when the deep linking response is returned, because that is the only moment AFCT
/// knows: from then on the link lives in the LMS and is never reported back. Without it the
/// picker cannot tell what it has already offered, and the same assignment can be added twice
/// under two names, which then disagree about which gradebook column is theirs.
///
/// A row written at that moment is a claim, not a fact, which is what `confirmedAt` records.
///
/// @namespace LTI
model LtiDeepLink {
  /// Unique identifier.
  id String @id @default(cuid())

  contextLink   LtiContextLink @relation(fields: [contextLinkId], references: [id], onDelete: Cascade)
  /// The LMS course the link was added to.
  contextLinkId String

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// The AFCT assignment it opens.
  assignmentId String

  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  /// Who added it. Null once that account is gone; the link outlives the person.
  createdByUserId String?

  /// When this record was created.
  createdAt DateTime @default(now())

  /// When the LMS first opened this link, and so the first proof it accepted the response.
  /// Null until then: AFCT signs a response and hands it to the browser, and whether the
  /// platform stored it is never reported back. A refused response leaves a row here that
  /// nothing in the LMS opens, which is why the picker treats these two states differently.
  confirmedAt DateTime?

  /// One link per assignment per LMS course. This is the constraint, not a check in the route:
  /// two submissions of the same form would otherwise both pass.
  @@unique([contextLinkId, assignmentId])
  @@index([assignmentId])
}
