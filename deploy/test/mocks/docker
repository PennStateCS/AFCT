#!/bin/sh
# Mock `docker` for the installer test harness. It answers the invocations
# install.sh makes and is steered by MOCK_* environment variables so a test can
# simulate failures without a real daemon:
#   MOCK_DOCKER_INFO_RC   `docker info` exit code             (default 0 = daemon up)
#   MOCK_CONFIG_RC        `compose config` exit code          (default 0)
#   MOCK_PULL_RC          `compose pull` exit code            (default 0)
#   MOCK_UP_RC            `compose up` exit code              (default 0)
#   MOCK_PS_EMPTY         if set, `compose ps -q` prints nothing (no container)
#   MOCK_PS_ID            container id `compose ps -q` prints  (default mockappid)
#   MOCK_STATE            container .State.Status              (default running)
#   MOCK_HEALTH           container .State.Health.Status       (default healthy)
#   MOCK_HEALTH_FLIP_AT   report `unhealthy` until the Nth health poll, then `healthy`
#   MOCK_HEALTH_COUNT_FILE  counter file backing MOCK_HEALTH_FLIP_AT (default $TMPDIR/...)
#   MOCK_VOLUMES          names `docker volume ls` prints      (default: none)
#   MOCK_CONFIG_VOLUMES   names `compose config --volumes`     (default afct_data)
#   MOCK_ARGS_LOG         if set, append every invocation's args to this file
#   MOCK_IMAGES           lines `docker images --format` prints (default: none)
#   MOCK_RMI_LOG          if set, append each `docker rmi` target to this file
#   MOCK_DEPLOYED_TAG     when set, the running container's image id becomes
#                         sha256:img-<tag> and `docker image inspect` returns
#                         sha256:img-<ref-tag>, so a test can make the running image
#                         agree or disagree with a tag (transaction-recovery tests).
#   MOCK_MISSING_TAGS     space-separated tags whose `docker image inspect` fails (image
#                         not present locally), to exercise the rollback retag fallback
#   MOCK_CONFIG_IMAGES_HONOR_TAG  if set, `compose config --images` interpolates the
#                         exported AFCT_APP_TAG (like real compose) instead of the fixed
#                         :latest, for the pinned-update rollback and prune tests

[ -n "${MOCK_ARGS_LOG:-}" ] && printf '%s\n' "$*" >> "$MOCK_ARGS_LOG" 2>/dev/null

cmd=${1:-}
[ "$#" -gt 0 ] && shift

case "$cmd" in
  info)
    # `docker info` or `docker info --format {{json .SecurityOptions}}`.
    case "$*" in
      *--format*) printf '[]\n'; exit 0 ;;
    esac
    exit "${MOCK_DOCKER_INFO_RC:-0}"
    ;;

  version)
    # `docker version` or `docker version --format {{.Server.Version}}`.
    case "$*" in
      *Server.Version*) printf '99.9.9\n' ;;
      *) printf 'Docker version 99.9.9 (mock)\n' ;;
    esac
    exit 0
    ;;

  inspect)
    # Return a value shaped to the requested -f/--format template.
    _tmpl=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -f|--format) _tmpl=${2:-}; shift 2 ;;
        *) shift ;;
      esac
    done
    case "$_tmpl" in
      *State.Status*)
        # MOCK_HEALTH_FLIP_AT lets a test model a slow boot: report `unhealthy` until the
        # Nth health inspect, then `healthy` from then on. MOCK_UNHEALTHY_AFTER is the
        # mirror: `healthy` for the first N inspects, then `unhealthy` (a service that comes
        # up and later degrades, for the stability-window test). Both count inspects in
        # MOCK_HEALTH_COUNT_FILE.
        if [ -n "${MOCK_UNHEALTHY_AFTER:-}" ]; then
          _hcf="${MOCK_HEALTH_COUNT_FILE:-$TMPDIR/mock_health_count}"
          _n=$(( $(cat "$_hcf" 2>/dev/null || echo 0) + 1 ))
          printf '%s' "$_n" > "$_hcf"
          if [ "$_n" -gt "$MOCK_UNHEALTHY_AFTER" ]; then
            printf '%s|unhealthy\n' "${MOCK_STATE:-running}"
          else
            printf '%s|healthy\n' "${MOCK_STATE:-running}"
          fi
        elif [ -n "${MOCK_HEALTH_FLIP_AT:-}" ]; then
          _hcf="${MOCK_HEALTH_COUNT_FILE:-$TMPDIR/mock_health_count}"
          _n=$(( $(cat "$_hcf" 2>/dev/null || echo 0) + 1 ))
          printf '%s' "$_n" > "$_hcf"
          if [ "$_n" -ge "$MOCK_HEALTH_FLIP_AT" ]; then
            printf '%s|healthy\n' "${MOCK_STATE:-running}"
          else
            printf '%s|unhealthy\n' "${MOCK_STATE:-running}"
          fi
        else
          printf '%s|%s\n' "${MOCK_STATE:-running}" "${MOCK_HEALTH:-healthy}"
        fi
        ;;
      *State.Health*) printf '%s\n' "${MOCK_HEALTH:-healthy}" ;;
      # The updater's own version label (org.opencontainers.image.version): empty by
      # default so the updater falls back to the image tag, which the self-update tests
      # control via MOCK_SELF_IMAGE_TAG.
      *image.version*) printf '%s\n' "${MOCK_IMAGE_VERSION:-}" ;;
      # Compose project discovery (updater): empty when MOCK_NO_PROJECT is set.
      *Labels*) [ -n "${MOCK_NO_PROJECT:-}" ] && printf '\n' || printf '%s\n' "${MOCK_PROJECT:-afct}" ;;
      *Config.Image*) printf 'ghcr.io/example/afct:%s\n' "${MOCK_SELF_IMAGE_TAG:-latest}" ;;
      # The updater resolves its own /afct host mount to spawn the self-update helper.
      *Mounts*) printf '%s\n' "${MOCK_AFCT_MOUNT:-/host/afct}" ;;
      *.Image*)
        # The running container's image id. With MOCK_DEPLOYED_TAG a test pins which
        # tag the container is actually on, so recovery can compare it against a target.
        if [ -n "${MOCK_DEPLOYED_TAG:-}" ]; then
          printf 'sha256:img-%s\n' "$MOCK_DEPLOYED_TAG"
        else
          printf 'sha256:mockimageid\n'
        fi
        ;;
      *) printf '\n' ;;
    esac
    exit 0
    ;;

  images)
    # `docker images --format {{.Repository}}:{{.Tag}}` — the local image inventory
    # the updater walks when pruning superseded versions.
    if [ -n "${MOCK_IMAGES:-}" ]; then
      printf '%s\n' "$MOCK_IMAGES"
    fi
    exit 0
    ;;

  rmi)
    # Record what the updater tried to delete so a test can assert which tags were
    # kept. Skip flags; the remainder is the image reference.
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -*) shift ;;
        *) [ -n "${MOCK_RMI_LOG:-}" ] && printf '%s\n' "$1" >> "$MOCK_RMI_LOG"; shift ;;
      esac
    done
    exit 0
    ;;

  image)
    # `docker image inspect -f {{.Id}} REF`, `docker image tag ID REF`, or
    # `docker image prune -f` (dangling cleanup after a prune).
    _sub=${1:-}
    [ "$#" -gt 0 ] && shift
    case "$_sub" in
      inspect)
        # The local image id a repo:tag resolves to. The ref is the last argument.
        _ref=""
        for _a in "$@"; do _ref=$_a; done
        _t=${_ref##*:}
        case " ${MOCK_MISSING_TAGS:-} " in
          *" $_t "*) exit 1 ;;   # image not present locally
        esac
        if [ -n "${MOCK_DEPLOYED_TAG:-}" ]; then
          printf 'sha256:img-%s\n' "$_t"
        else
          printf 'sha256:mockimageid\n'
        fi
        exit 0
        ;;
      *) exit 0 ;;
    esac
    ;;

  volume)
    # `docker volume ls --format {{.Name}}`.
    if [ -n "${MOCK_VOLUMES:-}" ]; then
      printf '%s\n' "$MOCK_VOLUMES"
    fi
    exit 0
    ;;

  compose)
    # Skip global flags (including --env-file FILE and -f FILE) to find the
    # subcommand, then keep the remaining args in $* for sub-flag matching.
    sub=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --env-file|-f|-p|--project-name|--project-directory|--profile) shift 2 ;;
        --*|-*) shift ;;
        *) sub="$1"; shift; break ;;
      esac
    done
    case "$sub" in
      version) printf 'Docker Compose version v99.9.9 (mock)\n'; exit 0 ;;
      config)
        case "$*" in
          *--images*)
            if [ -n "${MOCK_CONFIG_IMAGES_HONOR_TAG:-}" ]; then
              printf 'ghcr.io/example/afct:%s\n' "${AFCT_APP_TAG:-latest}"
            else
              printf 'ghcr.io/example/afct:latest\n'
            fi
            exit "${MOCK_CONFIG_RC:-0}" ;;
          *--volumes*) printf '%s\n' "${MOCK_CONFIG_VOLUMES:-afct_data}"; exit 0 ;;
          *) exit "${MOCK_CONFIG_RC:-0}" ;;
        esac
        ;;
      pull)
        # MOCK_PULL_FAIL_TIMES: fail the first N pulls, then succeed (transient failure,
        # for the retry test). MOCK_PULL_RC: a fixed exit code (always).
        if [ -n "${MOCK_PULL_FAIL_TIMES:-}" ]; then
          _pcf="${MOCK_PULL_COUNT_FILE:-$TMPDIR/mock_pull_count}"
          _pn=$(( $(cat "$_pcf" 2>/dev/null || echo 0) + 1 ))
          printf '%s' "$_pn" > "$_pcf"
          [ "$_pn" -le "$MOCK_PULL_FAIL_TIMES" ] && exit 1
          exit 0
        fi
        # MOCK_PULL_STDERR: what a failing pull prints. The installer classifies the
        # failure from this text, so a test needs to supply a realistic message.
        [ -n "${MOCK_PULL_STDERR:-}" ] && printf '%s\n' "$MOCK_PULL_STDERR" >&2
        exit "${MOCK_PULL_RC:-0}"
        ;;
      up)
        # Record the recreated services (e.g. "-d app nginx db-backup") so a test can
        # assert what an upgrade touches.
        [ -n "${MOCK_UP_LOG:-}" ] && printf '%s\n' "$*" >> "$MOCK_UP_LOG"
        exit "${MOCK_UP_RC:-0}"
        ;;
      ps)
        case "$*" in
          *-q*)
            [ -n "${MOCK_PS_EMPTY:-}" ] && exit 0
            printf '%s\n' "${MOCK_PS_ID:-mockappid}"
            ;;
          *) printf 'NAME       STATUS\nafct-app   running\n' ;;
        esac
        exit 0
        ;;
      logs|stop|down|rm) exit 0 ;;
      *) exit 0 ;;
    esac
    ;;

  *)
    exit 0
    ;;
esac
