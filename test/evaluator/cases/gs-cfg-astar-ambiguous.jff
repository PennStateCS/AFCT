<?xml version="1.0"?>
<!-- Highly ambiguous grammar for a* (S -> SS | a | epsilon). -->
<structure>
	<type>grammar</type>
	<production><left>S</left><right>SS</right></production>
	<production><left>S</left><right>a</right></production>
	<production><left>S</left><right></right></production>
</structure>
