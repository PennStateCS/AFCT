<?xml version="1.0"?>
<!-- Palindromes over {a,b}, including the empty string and the odd-length ones. -->
<structure>
	<type>grammar</type>
	<production><left>S</left><right>aSa</right></production>
	<production><left>S</left><right>bSb</right></production>
	<production><left>S</left><right>a</right></production>
	<production><left>S</left><right>b</right></production>
	<production><left>S</left><right></right></production>
</structure>
