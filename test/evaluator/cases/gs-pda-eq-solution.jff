<?xml version="1.0"?>
<!-- PDA for { w in {a,b}* | #a(w) = #b(w) } (equal numbers of a and b), accept by final
     state, modern "$" convention. The stack holds "$" at the bottom and above it a run of a
     single symbol: 'a' when a-surplus, 'b' when b-surplus. Reading a symbol cancels the
     opposite on top or extends the same. Accept when the surplus is zero (only "$" left). -->
<structure>
	<type>pda</type>
	<state id="0" name="q0">
		<x>100.0</x>
		<y>150.0</y>
		<initial />
	</state>
	<state id="1" name="q1">
		<x>300.0</x>
		<y>150.0</y>
	</state>
	<state id="2" name="q2">
		<x>500.0</x>
		<y>150.0</y>
		<final />
	</state>
	<transition>
		<from>0</from>
		<to>1</to>
		<read></read>
		<pop></pop>
		<push>$</push>
	</transition>
	<transition>
		<from>1</from>
		<to>1</to>
		<read>a</read>
		<pop>a</pop>
		<push>aa</push>
	</transition>
	<transition>
		<from>1</from>
		<to>1</to>
		<read>a</read>
		<pop>b</pop>
		<push></push>
	</transition>
	<transition>
		<from>1</from>
		<to>1</to>
		<read>a</read>
		<pop>$</pop>
		<push>a$</push>
	</transition>
	<transition>
		<from>1</from>
		<to>1</to>
		<read>b</read>
		<pop>b</pop>
		<push>bb</push>
	</transition>
	<transition>
		<from>1</from>
		<to>1</to>
		<read>b</read>
		<pop>a</pop>
		<push></push>
	</transition>
	<transition>
		<from>1</from>
		<to>1</to>
		<read>b</read>
		<pop>$</pop>
		<push>b$</push>
	</transition>
	<transition>
		<from>1</from>
		<to>2</to>
		<read></read>
		<pop>$</pop>
		<push></push>
	</transition>
</structure>
