<?xml version="1.0"?>
<!-- The same language through a helper nonterminal: the single characters and the empty
     string are pushed into T rather than sitting on S. -->
<structure>
	<type>grammar</type>
	<production><left>S</left><right>aSa</right></production>
	<production><left>S</left><right>bSb</right></production>
	<production><left>S</left><right>T</right></production>
	<production><left>T</left><right>a</right></production>
	<production><left>T</left><right>b</right></production>
	<production><left>T</left><right></right></production>
</structure>
