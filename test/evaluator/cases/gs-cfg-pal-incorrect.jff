<?xml version="1.0"?>
<!-- Even-length palindromes only. Every string it makes is in the answer's language, so a
     check that only sampled the submission's own strings would call this correct. -->
<structure>
	<type>grammar</type>
	<production><left>S</left><right>aSa</right></production>
	<production><left>S</left><right>bSb</right></production>
	<production><left>S</left><right></right></production>
</structure>
